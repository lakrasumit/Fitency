# ---------------------------------------------------------------------------
# Fitency frontend environment (see docs/PRD.md §10, docs/decisions.md D-26)
# ---------------------------------------------------------------------------
# All variables are optional. The app runs fully on the in-memory mock API
# (`src/lib/api/mock`) and needs no configuration to start.

# Base URL of the backend API. RESERVED: the HttpApiClient is intentionally
# not implemented until the backend contract is published (PRD.md §10).
# VITE_API_BASE_URL=

# Comma-separated mock operations to force-fail so error states can be
# previewed without a backend. Accepted values:
#   checklist | completion | create | analytics | progress | attempts
# Example: VITE_API_MOCK_FAIL=checklist,create
VITE_API_MOCK_FAIL=

# Mock response latency in milliseconds (default: 450).
# VITE_API_MOCK_LATENCY_MS=450
